# systemd reads a COPY at /etc/mihomo-sla/backend.env.
# Python does not automatically load .env files.
MIHOMO_API=http://127.0.0.1:19091
MIHOMO_SECRET=
SLA_DOWNLOAD_PROXY=http://127.0.0.1:7890
SLA_PROBE_URL=https://www.gstatic.com/generate_204
SLA_INTERVAL=60
SLA_TIMEOUT_MS=5000
SLA_CONCURRENCY=5
# Unset these paths for a local development checkout.
# SLA_DB=/var/lib/mihomo-sla/sla.db
# SLA_PROVIDER_FILE=/var/lib/mihomo-sla-monitor/nodes.yaml
# SLA_PROBE_SETTINGS_FILE=/var/lib/mihomo-sla/probe-settings.json
